---
import "normalize.css/normalize.css"
import "../global.css"
import { getCollection } from "astro:content"
import PostPreview, {
  width as previewWidth,
  height as previewHeight,
} from "./PostPreview.astro"
import readingTime from "reading-time"
import {
  faChevronLeft,
  faChevronRight,
} from "@fortawesome/free-solid-svg-icons"
import FaIcon from "./FaIcon.astro"

export const pageSize = 20

interface Props {
  year?: number
  page?: number
}

const { year, page: pageProp } = Astro.props
const page = pageProp ?? 1

let allPosts = (
  await getCollection(
    "posts",
    data => !year || data.data.date.getFullYear() === year
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

let posts = allPosts
if (!year) {
  const start = pageSize * (page - 1)
  posts = posts.slice(start, start + pageSize)
}

const maxPage = Math.ceil(allPosts.length / pageSize)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main>
      <ol>
        {
          posts.map(post => (
            <li>
              <PostPreview
                pagePath={`/posts/${post.id}/`}
                meta={post.data}
                timeToRead={readingTime(post.body ?? "")}
              />
            </li>
          ))
        }
      </ol>
      {
        !year && (page > 1 || page < maxPage) && (
          <div class="pagination">
            {page > 1 && (
              <a href={`/page/${page - 1}`} class="shaded-button">
                <FaIcon icon={faChevronLeft} /> Newer posts
              </a>
            )}
            {page < maxPage && (
              <a href={`/page/${page + 1}`} class="shaded-button">
                Older posts <FaIcon icon={faChevronRight} />
              </a>
            )}
          </div>
        )
      }
    </main>
  </body>
</html>

<style
  define:vars={{
    previewWidth: `${previewWidth}px`,
    previewHeight: `${previewHeight}px`,
  }}
>
  ol {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  ol > li {
    transition: 0.2s;
    display: block;
    margin: 16px;
    border-radius: 16px;
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    position: relative;
    width: var(--previewWidth);
    max-width: calc(100vw - 72px);
    height: var(--previewHeight);
    max-height: calc(100vh - 72px);
    isolation: isolate; /* required for Safari to apply overflow: hidden to border radius */
  }

  ol > li:hover,
  ol > li:focus-within {
    box-shadow: 0px 1px 12px rgba(0, 0, 0, 0.75);
  }

  .pagination {
    margin: 16px;
    text-align: center;
  }

  .pagination a {
    margin: 16px;
    width: 118px;
    color: #000;
  }

  .pagination a:hover {
    color: #000;
  }
</style>
