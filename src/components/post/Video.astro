---
interface Props {
  src: string
  type?: string
}

const { src, type } = Astro.props
const videoPath = `../../../content/posts/${Astro.params.id}/${src}`
const videoLoader = import.meta.glob<{ default: string }>(
  "../../../content/posts/**/*.{mp4,m4v}"
)[videoPath]
const video = (await videoLoader()).default
---

<div class="video-container">
  <video controls>
    <source src={video} type={type ?? "video/mp4"} />
  </video>
</div>

<style>
  .video-container {
    text-align: center;
    font-size: 0;
    margin: 32px;
  }

  .video-container video {
    max-height: 80vh;
    max-width: 100%;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    border-radius: 2px;
  }

  :global(.gallery) .video-container {
    margin: 16px;
  }

  :global(.gallery) .video-container video {
    max-height: 45vh;
  }
</style>
