---
import { faChevronUp } from "@fortawesome/free-solid-svg-icons"
import PostMeta, { type Props as PostMetaProps } from "../PostMeta.astro"
import type { ImageMetadata } from "astro"
import FaIcon from "../FaIcon.astro"
import { Image, Picture } from "astro:assets"

interface Props {
  image: ImageMetadata
  title: string
  meta: PostMetaProps
}

const { image, title, meta } = Astro.props
---

<div class="titlescreen">
  <Image
    src={image}
    layout="full-width"
    alt=""
    loading="eager"
    class="heroimg"
    fit="cover"
  />
  <div class="titlebox">
    <h1>{title}</h1>
    <div class="post-meta">
      <PostMeta {...meta} />
    </div>
  </div>
  <div class="scrollable-indicator">
    <FaIcon icon={faChevronUp} />
  </div>
</div>

<script>
  const heroImgs = document.getElementsByClassName("heroimg")
  const updateParallax = () => {
    window.requestAnimationFrame(() => {
      const scrollRatio = Math.max(
        0,
        Math.min(1, window.scrollY / window.innerHeight)
      )
      for (const heroImg of heroImgs) {
        if (heroImg instanceof HTMLElement) {
          heroImg.style.setProperty("--scroll-ratio", scrollRatio.toString())
        }
      }
    })
  }

  const isMobileDevice = /Mobi/i.test(window.navigator.userAgent)
  if (!isMobileDevice) {
    updateParallax()
    window.addEventListener("scroll", updateParallax)
    window.addEventListener("resize", updateParallax)
  }
</script>

<style>
  .titlescreen {
    height: 100vh;
    position: relative;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .heroimg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(calc(50% * var(--scroll-ratio, 0)));
  }

  .titlebox {
    position: absolute;
    left: 0;
    bottom: 33%;
    width: 100%;
    color: #fff;
    text-align: center;
  }

  .titlebox h1 {
    font-size: 4vw;
    text-shadow: 2px 2px 4px #000;
    margin-bottom: 32px;
    padding: 0 32px;
    overflow-wrap: break-word;
    hyphens: auto;
    font-weight: normal;
  }

  @media (max-width: 700px) {
    .titlebox h1 {
      font-size: 24px;
    }
  }

  @media (min-width: 1600px) {
    .titlebox h1 {
      font-size: 64px;
    }
  }

  .post-meta {
    background-color: rgba(0, 0, 0, 0.6);
    display: inline-block;
    padding: 16px;
    border-radius: 4px;
    text-align: left;
  }

  .scrollable-indicator {
    color: rgba(0, 0, 0, 0.6);
    font-size: 6rem;
    position: absolute;
    top: 75%;
    left: 50%;
    transform: translate(-50%, 0);
  }
</style>
