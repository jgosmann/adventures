---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import Caption from "./Caption.astro"
import VerticalScroll from "../VerticalScroll.astro"

interface Props {
  alt?: string
  caption?: string
  src: string
  height?: number
}

const { alt, caption, src } = Astro.props
const height = Astro.props.height ?? 600

const imagePath = `../../../content/posts/${Astro.params.id}/pano/${src}`
const imageLoader = import.meta.glob<{ default: ImageMetadata }>(
  "../../../content/posts/*/pano/*"
)[imagePath]
if (!imageLoader) {
  throw new Error(`Image path '${Astro.params.id}/pano/${src}' does not exist.`)
}
const { default: image } = await imageLoader()
let scaledHeight = Math.min(height, image.height)
let scaledWidth = (scaledHeight / image.height) * image.width
const maxDensity = 2
const maxWebpWidth = 16383
const maxPanoWidth = Math.floor(maxWebpWidth / maxDensity)
if (scaledWidth > maxPanoWidth) {
  scaledHeight *= maxPanoWidth / scaledWidth
  scaledWidth = maxPanoWidth
}
---

<div class="pano-container">
  {
    image && (
      <VerticalScroll>
        <Image
          src={image}
          densities={[1, 2]}
          width={scaledWidth}
          height={scaledHeight}
          alt={alt || caption || ""}
        />
      </VerticalScroll>
    )
  }
  {
    (caption || Astro.slots.has("default")) && (
      <Caption>
        {caption}
        <slot />
      </Caption>
    )
  }
</div>

<style
  define:vars={{
    "orig-height": scaledHeight,
    "orig-width": scaledWidth,
  }}
>
  .pano-container {
    margin: 32px 0;
    scroll-snap-align: start;
    position: relative;
  }

  .pano-container img {
    max-height: 100vh;
    max-width: calc(100vh / var(--orig-height) * var(--orig-width));
    margin-left: auto;
    margin-right: auto;
  }
</style>
