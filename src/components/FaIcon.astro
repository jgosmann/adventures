---
import {
  config,
  icon,
  type Attributes,
  type IconDefinition,
  type Styles,
} from "@fortawesome/fontawesome-svg-core"

config.autoAddCss = false

interface Props {
  icon: IconDefinition
  ariaLabel?: string
  class?: string
  styles?: Styles
}

const { icon: iconDef, ariaLabel, class: classes, styles } = Astro.props

const attributes: Attributes = { "aria-hidden": ariaLabel ? "false" : "true" }
if (ariaLabel) {
  Object.assign(attributes, { "aria-label": ariaLabel })
}
const iconHtml = icon(iconDef, {
  classes,
  attributes,
  styles,
}).html
---

<Fragment set:html={iconHtml} />
