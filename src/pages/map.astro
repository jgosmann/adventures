---
import OverviewMap from "../components/leaflet/OverviewMap"
import { getCollection } from "astro:content"
import FullHeightLayout from "../layouts/FullHeightLayout.astro"

const allPosts = await getCollection("posts")
---

<FullHeightLayout title="Map" description={null} imageSrc={null}>
  <OverviewMap posts={allPosts} client:only="react" />
</FullHeightLayout>

<style is:global>
  a.post-preview-link:hover {
    color: var(--color-accent) !important;
  }
</style>
