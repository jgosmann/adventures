---
import { getCollection } from "astro:content"
import Page, { pageSize } from "../../layouts/Page.astro"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return [
    ...Array(Math.ceil(posts.length / pageSize))
      .keys()
      .map(i => ({
        params: { id: i + 1 },
        props: { page: i + 1 },
      })),
  ]
}

const { page } = Astro.props
---

<Page page={page} />
