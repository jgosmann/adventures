---
import "normalize.css/normalize.css"
import "../../global.css"
import { getCollection, render, z } from "astro:content"
import placeholder from "../../components/placeholder.astro"
import Titlescreen from "../../components/post/Titlescreen.astro"
import Gallery from "../../components/post/Gallery.astro"
import GradeLoader from "../../components/post/GradeLoader.astro"
import Rimg from "../../components/post/Rimg.astro"
import Video from "../../components/post/Video.astro"
import LocLoader from "../../components/post/LocLoader.astro"
import TravelLoader from "../../components/post/TravelLoader.astro"
import GpxTrackLoader from "../../components/post/GpxTrackLoader.astro"
import ClimbingLog from "../../components/post/ClimbingLog/ClimbingLog.astro"
import {
  styleMap,
  type AscenionStyle,
} from "../../components/post/ClimbingLog/Style.astro"
import {
  boulderingGrades,
  sportGrades,
} from "../../components/post/ClimbingLog/Grade/types"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }))
}

const GradeSchema = z.object({
  system: z.enum([...sportGrades, ...boulderingGrades]),
  value: z.string(),
})
const Climbs = z.array(
  z.object({
    ascents: z.array(
      z.object({
        name: z.string(),
        grade: GradeSchema.nullable(),
        style: z
          .enum(Object.keys(styleMap) as [AscenionStyle, ...AscenionStyle[]])
          .nullable(),
        pitches: z.optional(
          z.array(
            z.object({
              name: z.string().nullable(),
              grade: GradeSchema,
              style: z
                .enum(
                  Object.keys(styleMap) as [AscenionStyle, ...AscenionStyle[]]
                )
                .nullable(),
            })
          )
        ),
      })
    ),
  })
)

const { post } = Astro.props
const climbsYml = await import(
  `../../../content/posts/${post.id}/climbs.yml`
).catch(() => ({ default: undefined }))
const climbs = await Climbs.parseAsync(climbsYml.default)
const { Content } = await render(post)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main>
      <article>
        <Titlescreen
          image={post.data.background}
          title={post.data.title}
          meta={{
            date: post.data.date,
            timeToRead: { minutes: 0 }, // FIXME
          }}
        />
        <div class="content">
          <Content
            components={{
              ElevationProfile: placeholder,
              Gallery,
              GpxTrack: GpxTrackLoader,
              Grade: GradeLoader,
              Loc: LocLoader,
              Link: placeholder,
              Nextday: placeholder,
              Pano: placeholder,
              Pano2x: placeholder,
              Rimg,
              Travel: TravelLoader,
              Video,
            }}
          />
          {
            climbs && climbs[0].ascents && (
              <ClimbingLog ascents={climbs[0].ascents} />
            )
          }
        </div>
        <div style="height: 25vh;"></div>
      </article>
    </main>
  </body>
</html>

<style>
  main {
    height: 100%;
    position: relative;
    z-index: 0;
  }

  article {
    height: 100%;
  }
</style>

<style is:global>
  .content ol,
  .content > p,
  .content ul,
  .content h1,
  .content h2,
  .content h3,
  .content form {
    margin: 0 auto 1em;
    line-height: 1.25;
    color: #222;
    width: 600px;
    max-width: calc(100vw - 32px);
  }

  .content .popover {
    width: auto;
    margin: 0;
    z-index: 9999;
  }

  .content ul {
    padding: 0 20px;
  }

  .content ul,
  .content ol {
    box-sizing: border-box;
  }
  .content ul ul,
  .content ol ul,
  .content ul ol,
  .content ol ol {
    max-width: 100%;
    margin: 0;
  }

  .content iframe {
    margin: 1em auto;
    display: block;
    max-width: 100vw;
  }

  .attribution {
    color: #888;
    font-size: 0.8em;
  }

  .attribution a {
    color: #888;
  }

  .attribution a:hover {
    text-decoration: underline;
  }
</style>
