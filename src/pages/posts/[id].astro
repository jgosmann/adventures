---
import "normalize.css/normalize.css"
import "../../global.css"
import { getCollection, render, z } from "astro:content"
import Titlescreen from "../../components/post/Titlescreen.astro"
import Gallery from "../../components/post/Gallery.astro"
import GradeLoader from "../../components/post/GradeLoader.astro"
import Rimg from "../../components/post/Rimg.astro"
import Video from "../../components/post/Video.astro"
import LocLoader from "../../components/post/LocLoader.astro"
import TravelLoader from "../../components/post/TravelLoader.astro"
import GpxTrackLoader from "../../components/post/GpxTrackLoader.astro"
import ClimbingLog from "../../components/post/ClimbingLog/ClimbingLog.astro"
import {
  styleMap,
  type AscenionStyle,
} from "../../components/post/ClimbingLog/Style.astro"
import {
  boulderingGrades,
  sportGrades,
} from "../../components/post/ClimbingLog/Grade/types"
import Nextday from "../../components/post/Nextday.astro"
import Pano from "../../components/post/Pano.astro"
import Pano2x from "../../components/post/Pano2x.astro"
import ElevationProfileLoader from "../../components/post/ElevationProfileLoader.astro"
import readingTime from "reading-time"
import DefaultLayout from "../../layouts/DefaultLayout.astro"
import { getImage } from "astro:assets"
import type { Node } from "@types/mdast"
import { fromMarkdown } from "mdast-util-from-markdown"
import { mdxFromMarkdown } from "mdast-util-mdx"
import { mdxjs } from "micromark-extension-mdxjs"

export async function getStaticPaths() {
  function areSubsequentDays(a: Date, b: Date): boolean {
    const normalizedA = new Date(a.getFullYear(), a.getMonth(), a.getDate())
    const normalizedB = new Date(b.getFullYear(), b.getMonth(), b.getDate())
    return normalizedB.valueOf() - normalizedA.valueOf() === 24 * 60 * 60 * 1000
  }
  const posts = await getCollection("posts")
  posts.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  return posts.map((post, i) => {
    let nextpost = i + 1 < posts.length ? posts[i + 1] : null
    if (nextpost && !areSubsequentDays(post.data.date, nextpost.data.date)) {
      nextpost = null
    }
    return {
      params: { id: post.id },
      props: { post, nextpost },
    }
  })
}

const GradeSchema = z.object({
  system: z.enum([...sportGrades, ...boulderingGrades]),
  value: z.string(),
})
const Climbs = z.optional(
  z.array(
    z.object({
      ascents: z.array(
        z.object({
          name: z.string(),
          grade: GradeSchema.optional().transform(x => x ?? null),
          style: z
            .enum(Object.keys(styleMap) as [AscenionStyle, ...AscenionStyle[]])
            .optional()
            .transform(x => x ?? null),
          pitches: z.optional(
            z.array(
              z.object({
                name: z
                  .string()
                  .optional()
                  .transform(x => x ?? null),
                grade: GradeSchema,
                style: z
                  .enum(
                    Object.keys(styleMap) as [AscenionStyle, ...AscenionStyle[]]
                  )
                  .optional()
                  .transform(x => x ?? null),
              })
            )
          ),
        })
      ),
    })
  )
)

const { post, nextpost } = Astro.props
const climbsYml = await import(
  `../../../content/posts/${post.id}/climbs.yml`
).catch(() => ({ default: undefined }))

const [climbs, { Content }, ogImage] = await Promise.all([
  Climbs.parseAsync(climbsYml.default),
  render(post),
  getImage({ src: post.data.background, width: 800 }),
])

function* mdastToWords(node: Node): Generator<string> {
  switch (node.type) {
    case "root":
    case "paragraph":
    case "link":
      for (const childGen of node.children.flatMap(mdastToWords)) {
        yield* childGen
      }

    case "text":
      if (node.value) {
        yield* node.value.replaceAll("\n", " ").split(/\s+/)
      }

    case "mdxJsxFlowElement":
    case "mdxJsxTextElement":
      return

    default:
      throw new Error(`Unhandled mdast node type: ${node.type}`)
  }
}

const mdast = fromMarkdown(post.body ?? "", {
  extensions: [mdxjs()],
  mdastExtensions: [mdxFromMarkdown()],
})

const buffer = []
const wordGen = mdastToWords(mdast)
for (let i = 0; i < 55; ++i) {
  const nextWord = wordGen.next()
  if (nextWord.done) {
    break
  }
  buffer.push(nextWord.value)
}

const excerpt = buffer.join(" ")
---

<DefaultLayout
  title={post.data.title}
  description={excerpt}
  imageSrc={ogImage.src}
>
  <article>
    <Titlescreen
      image={post.data.background}
      title={post.data.title}
      meta={{
        date: post.data.date,
        timeToRead: readingTime(post.body ?? ""),
      }}
    />
    <div class="content">
      <Content
        components={{
          ElevationProfile: ElevationProfileLoader,
          Gallery,
          GpxTrack: GpxTrackLoader,
          Grade: GradeLoader,
          Loc: LocLoader,
          Pano,
          Pano2x,
          Rimg,
          Travel: TravelLoader,
          Video,
        }}
      />
      {nextpost && <Nextday path={`/posts/${nextpost.id}`} />}
      {
        climbs && climbs[0].ascents && (
          <ClimbingLog ascents={climbs[0].ascents} />
        )
      }
    </div>
    <div style="height: 25vh;"></div>
  </article>
</DefaultLayout>

<style>
  main {
    height: 100%;
    position: relative;
    z-index: 0;
  }

  article {
    height: 100%;
  }
</style>

<style is:global>
  .content ol,
  .content > p,
  .content ul,
  .content h1,
  .content h2,
  .content h3,
  .content form {
    margin: 0 auto 1em;
    line-height: 1.25;
    color: #222;
    width: 600px;
    max-width: calc(100vw - 32px);
  }

  .content .popover {
    width: auto;
    margin: 0;
    z-index: 9999;
  }

  .content ul {
    padding: 0 20px;
  }

  .content ul,
  .content ol {
    box-sizing: border-box;
  }
  .content ul ul,
  .content ol ul,
  .content ul ol,
  .content ol ol {
    max-width: 100%;
    margin: 0;
  }

  .content iframe {
    margin: 1em auto;
    display: block;
    max-width: 100vw;
  }

  .attribution {
    color: #888;
    font-size: 0.8em;
  }

  .attribution a {
    color: #888;
  }

  .attribution a:hover {
    text-decoration: underline;
  }
</style>
