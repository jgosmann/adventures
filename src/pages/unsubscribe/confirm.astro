---
import ContentStyleWrapper from "../../components/ContentStyleWrapper.astro"
import ConfirmationButton from "../../components/doveseed/ConfirmationButton"
import DefaultLayout from "../../layouts/DefaultLayout.astro"
---

<DefaultLayout
  title="Unsubscribe confirmation"
  description={null}
  imageSrc={null}
>
  <ContentStyleWrapper>
    <h1>Confirm unsubscribing</h1>
    <p>
      You are unsubscribing the following email address from email notifications
      for new posts:
    </p>
    <ConfirmationButton
      client:load
      url="https://doveseed.adventures.jgosmann.de/unsubscribe/confirm/"
      submitLabel="Confirm"
    />
  </ContentStyleWrapper>
</DefaultLayout>
