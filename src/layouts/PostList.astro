---
import "normalize.css/normalize.css"
import "../global.css"
import PostPreview, {
  width as previewWidth,
  height as previewHeight,
} from "../components/PostPreview.astro"
import readingTime from "reading-time"
import type { InferEntrySchema } from "astro:content"
import DefaultLayout from "./DefaultLayout.astro"

interface Props {
  title: string | null
  posts: Array<{
    id: string
    body?: string
    data: InferEntrySchema<"posts">
  }>
}

const { title, posts } = Astro.props
---

<DefaultLayout title={title} description={null} imageSrc={null}>
  <ol>
    {
      posts.map(post => (
        <li>
          <PostPreview
            pagePath={`/posts/${post.id}/`}
            meta={post.data}
            timeToRead={readingTime(post.body ?? "")}
          />
        </li>
      ))
    }
  </ol>
  <slot name="footer" />
</DefaultLayout>

<style
  define:vars={{
    previewWidth: `${previewWidth}px`,
    previewHeight: `${previewHeight}px`,
  }}
>
  ol {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  ol > li {
    transition: 0.2s;
    display: block;
    margin: 16px;
    border-radius: 16px;
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    position: relative;
    width: var(--previewWidth);
    max-width: calc(100vw - 72px);
    height: var(--previewHeight);
    max-height: calc(100vh - 72px);
    isolation: isolate; /* required for Safari to apply overflow: hidden to border radius */
  }

  ol > li:hover,
  ol > li:focus-within {
    box-shadow: 0px 1px 12px rgba(0, 0, 0, 0.75);
  }
</style>
