---
import "normalize.css/normalize.css"
import "../global.css"
import Navigation from "../components/navigation/Navigation.astro"
import Head, { type Props as HeadProps } from "../components/Head.astro"

interface Props extends HeadProps {}

const headProps = Astro.props
---

<html lang="en">
  <Head {...headProps} />
  <body><Navigation /><main><slot /></main></body>
</html>

<style>
  html {
    height: 100%;
    overflow: hidden;
  }

  body {
    margin-top: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
    position: relative;
    z-index: 0;
  }
</style>
