---
import "normalize.css/normalize.css"
import "../global.css"
import Head, { type Props as HeadProps } from "../components/Head.astro"
import Navigation from "../components/navigation/Navigation.astro"

interface Props extends HeadProps {
  noTopMargin?: boolean
  mainLang?: string
}

const { noTopMargin, mainLang, ...headProps } = Astro.props
---

<html lang="en">
  <Head {...headProps} />
  <body>
    <Navigation fixed noTopMargin={noTopMargin} />
    <main lang={mainLang}>
      <slot />
    </main>
  </body>
</html>
